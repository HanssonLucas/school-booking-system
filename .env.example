# Email provider
# Use "console" for local development.
# Use "resend" when you want to send real emails through Resend.
EMAIL_PROVIDER=console

# Required when EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Example sender address for Resend test emails
EMAIL_FROM="Bokningssystem <onboarding@resend.dev>"

# App URL
# Used in emails to link back to the booking system.
NEXT_PUBLIC_APP_URL=http://localhost:3000